// Generated by `npm run setup` from .shortener/state.json — IDs only, no secrets.
// Re-run `npm run setup` (or `npm run domain:add`) to regenerate.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shortener-edge",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "MODE": "free",
    "STRICT_LOGGING": "false",
    "RETENTION_MONTHS": "13",
    "AE_DATASET": "shortener_clicks"
  },
  "kv_namespaces": [],
  "r2_buckets": [],
  "hyperdrive": [],
  "analytics_engine_datasets": [
    {
      "binding": "CLICKS_AE",
      "dataset": "shortener_clicks"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "7001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "15 0 * * *",
      "0 */6 * * *"
    ]
  },
  "routes": []
}
