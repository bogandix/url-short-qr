// Generated by `npm run setup` from .shortener/state.json — IDs only, no secrets.
// Re-run `npm run setup` (or `npm run domain:add`) to regenerate.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shortener-edge",
  "main": "src/index.ts",
  "account_id": "e16b3865e05df85a04bb5e97566b2257",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "MODE": "free",
    "STRICT_LOGGING": "false",
    "RETENTION_MONTHS": "13",
    "AE_DATASET": "shortener_clicks",
    "CF_ACCOUNT_ID": "e16b3865e05df85a04bb5e97566b2257"
  },
  "kv_namespaces": [
    {
      "binding": "LINKS",
      "id": "b0eec002036541ca8e5e9c361cc7b221"
    }
  ],
  "r2_buckets": [],
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "437872d0bd4e4c9193de7b4009173546"
    },
    {
      "binding": "DB_ADMIN",
      "id": "b2cbb476f7e54400a54491295a6f8339"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "CLICKS_AE",
      "dataset": "shortener_clicks"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "7001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "15 0 * * *",
      "0 */6 * * *"
    ]
  },
  "routes": [
    {
      "pattern": "vv1.eu",
      "custom_domain": true
    },
    {
      "pattern": "www.vv1.eu",
      "custom_domain": true
    },
    {
      "pattern": "*.vv1.eu/*",
      "zone_id": "c79814a30c4d0618583f1eea7a0d0c26"
    }
  ]
}
