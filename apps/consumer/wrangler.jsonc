// Generated by `npm run setup` from .shortener/state.json — IDs only, no secrets.
// Re-run `npm run setup` (or `npm run domain:add`) to regenerate.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shortener-consumer",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "REPLACE_WITH_EDGE_HYPERDRIVE_ID"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "shortener-clicks",
        "max_batch_size": 100,
        "max_batch_timeout": 10,
        "max_retries": 10,
        "retry_delay": 30,
        "dead_letter_queue": "shortener-clicks-dlq"
      }
    ]
  }
}
